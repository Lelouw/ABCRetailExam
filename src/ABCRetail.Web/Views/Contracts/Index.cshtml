@model IReadOnlyList<StoredFile>
@{
    ViewData["Title"] = "Contracts";
}

<h1 class="page-title">Contracts</h1>
<p class="page-lead">Files are stored on the <strong>contracts</strong> Azure file share. The share is private, and downloads go through this app.</p>

<div class="panel mb-4">
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        <label class="form-label" for="contract">Contract file</label>
        <input class="form-control mb-3" type="file" id="contract" name="contract" accept=".pdf,.txt,.docx,.png,.jpg,.jpeg" />
        <button type="submit" class="btn btn-teal">Upload to Azure Files</button>
    </form>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="mb-0">No contracts uploaded yet.</p>
    }
    else
    {
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Size</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var file in Model)
                {
                    <tr>
                        <td>@file.Name</td>
                        <td>@((file.Size ?? 0).ToString("N0")) bytes</td>
                        <td class="text-end">
                            <a asp-action="Download" asp-route-name="@file.Name">Download</a>
                            <form class="d-inline" asp-action="Delete" method="post">
                                <input type="hidden" name="name" value="@file.Name" />
                                <button type="submit" class="btn btn-link text-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
