@model IReadOnlyList<OrderEntity>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Orders</h1>
        <p class="page-lead">A new order is saved here and a message is placed on the <strong>order-processing</strong> queue.</p>
    </div>
    <a class="btn btn-teal" asp-action="Create">Place order</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="mb-0">No orders yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var badge = order.Status switch
                        {
                            OrderStatuses.Processed => "badge-processed",
                            OrderStatuses.Rejected => "badge-rejected",
                            _ => "badge-queued"
                        };
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@order.RowKey">@order.RowKey</a></td>
                            <td>@order.CustomerName</td>
                            <td>@order.Quantity × @order.ProductName</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td><span class="status-badge @badge">@order.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
