@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ABCRetail.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">AR</span>
                    <span>ABC Retail</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Readings" ? "active" : "")" asp-controller="Readings" asp-action="Index">Readings</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">Customers</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">Products</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Orders" ? "active" : "")" asp-controller="Orders" asp-action="Index">Orders</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Inventory" ? "active" : "")" asp-controller="Inventory" asp-action="Index">Inventory</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Contracts" ? "active" : "")" asp-controller="Contracts" asp-action="Index">Contracts</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Logs" ? "active" : "")" asp-controller="Logs" asp-action="Index">Logs</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container page-wrap">
        @if (Storage.UsesLocalFiles)
        {
            <div class="alert alert-warning">Azurite covers tables, blobs, and queues. It does not support Azure Files, so contracts and logs are saved on this PC until you use a real storage connection string.</div>
        }
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            Live readings are queued, processed by Azure Functions, and stored in Azure SQL. Retail screens use Table Storage, Blob Storage, Queue Storage, and Azure Files.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
